# =============================================
# MARAM MANAGER — ROOT .gitignore
# Covers both frontend/ and backend/
# =============================================

# === Dependencies ===
node_modules/
.pnp
.pnp.js

# === Build outputs ===
dist/
dist-ssr/
build/
out/

# === Environment variables (NEVER commit these) ===
.env
.env.local
.env.*.local
.env.production
.env.staging
backend/.env
frontend/.env
frontend/.env.local

# === Logs ===
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# === Vite cache ===
.vite/
vite.config.js.timestamp-*

# === Coverage & Testing ===
coverage/
.nyc_output/
junit.xml
/test-results/
/playwright-report/
/playwright/.cache/

# === OS files ===
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# === Editor / IDE ===
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# === MongoDB local dumps ===
*.bson
dump/

# === TypeScript (if added later) ===
*.tsbuildinfo

# === Storybook (if added later) ===
storybook-static/

# === Runtime / Process ===
pids/
*.pid
*.seed
*.pid.lock

# === Miscellaneous ===
*.local
.cache/
tmp/
temp/

# === Project working documents (not source code) ===
maram_manager_context.md
